@model MetroBalance.Core.Contracts.CardEnquiryResult

<div class="panel panel--raised p-4 p-lg-5 mb-4" id="realCardGuidance">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <span class="badge-demo">Real card &mdash; no online balance</span>
            <h2 class="h5 fw-bold mt-3 mb-2">How to read the balance of @Model.CardNumber</h2>
            <p class="text-muted mb-0" style="max-width:44rem;">@Model.Message</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.PolicyNote))
    {
        <div class="alert-mb alert-mb--info mb-4">
            <strong>Why there is no balance here:</strong> @Model.PolicyNote
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <h3 class="h6 fw-bold mb-3">Read it at the station</h3>
            <ol class="guide-steps mb-0">
                @foreach (var step in Model.Steps)
                {
                    <li>@step</li>
                }
            </ol>
        </div>

        <div class="col-lg-6">
            <h3 class="h6 fw-bold mb-3">Official DMRC channels</h3>
            <div class="d-flex flex-column gap-2">
                @foreach (var link in Model.OfficialLinks)
                {
                    <a class="official-link @(link.IsPrimary ? "official-link--primary" : "")" href="@link.Url" target="_blank" rel="noopener noreferrer">
                        <span class="official-link__title">
                            @link.Title
                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg>
                        </span>
                        <span class="official-link__desc">@link.Description</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
