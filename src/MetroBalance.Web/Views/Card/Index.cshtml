@model MetroBalance.Web.Models.CardLookupViewModel
@{
    ViewData["Title"] = "Check Smart Card Balance";
}

<section class="about-hero">
    <div class="container">
        <h1 class="h2 fw-bold mb-2">Check your Smart Card balance</h1>
        <p class="mb-0 opacity-75" style="max-width:40rem;">
            Enter your Delhi Metro Smart Card number to see the available balance, recharge history and journey
            transactions &mdash; all in Indian Rupees.
        </p>
    </div>
</section>

<section class="section section--tight">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="panel p-4">
                    <h2 class="h6 fw-bold mb-3">Card details</h2>
                    <div class="mode-switch mb-3" role="group" aria-label="What would you like to see?">
                        <a class="mode-switch__btn @(Model.AmountOnly ? "" : "is-active")"
                           asp-controller="Card" asp-action="Index" asp-route-cardNumber="@Model.CardNumber">Full statement</a>
                        <a class="mode-switch__btn @(Model.AmountOnly ? "is-active" : "")"
                           asp-controller="Card" asp-action="Index" asp-route-mode="amount" asp-route-cardNumber="@Model.CardNumber">Balance only</a>
                    </div>
                    <form asp-controller="Card" asp-action="Lookup" method="post" id="serverLookupForm">
                        <input type="hidden" name="mode" value="@(Model.AmountOnly ? "amount" : "statement")" />
                        <label class="form-label fw-semibold" for="cardNumberInput">Smart Card number</label>
                        <input type="text" class="form-control lookup-input" id="cardNumberInput" name="cardNumber"
                               value="@Model.CardNumber" placeholder="e.g. DMRC-DEMO-1001" autocomplete="off" maxlength="25" />
                        <button class="btn btn-mb-primary w-100 mt-3" type="submit">
                            @(Model.AmountOnly ? "Check balance" : "Show full statement")
                        </button>
                    </form>

                    <hr class="my-4" />

                    <div class="small text-uppercase fw-bold text-muted mb-2" style="letter-spacing:.08em;">Demo card numbers</div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var demoCard in Model.DemoCardNumbers)
                        {
                            <a class="demo-chip text-decoration-none align-self-start" href="@Url.Action("Index", "Card", new { cardNumber = demoCard, mode = Model.AmountOnly ? "amount" : null })">@demoCard</a>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert-mb alert-mb--error mb-4">@Model.ErrorMessage</div>
                }

                @if (Model.AmountOnly && Model.Amount is not null)
                {
                    if (Model.Amount.BalanceAvailableOnline)
                    {
                        <div class="balance-card mb-4">
                            <div class="position-relative" style="z-index:2;">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                    <div>
                                        <div class="hero-visual__label">Available balance &mdash; DEMO DATA</div>
                                        <div class="balance-amount">@Model.Amount.AmountFormatted</div>
                                        <div class="opacity-75">@Model.Amount.CardNumber</div>
                                    </div>
                                    <div class="text-md-end">
                                        <span class="badge-demo">Demo Data</span>
                                        <div class="mt-2 small opacity-75">
                                            @(Model.Amount.LastUpdatedOnFormatted is null ? "Last update not available" : "Last updated " + Model.Amount.LastUpdatedOnFormatted)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-center">
                            <a class="btn btn-mb-outline" asp-controller="Card" asp-action="Index" asp-route-cardNumber="@Model.Amount.CardNumber">
                                View full statement
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="panel panel--raised p-4 p-lg-5">
                            <span class="badge-demo">Real card &mdash; no online balance</span>
                            <h2 class="h5 fw-bold mt-3 mb-2">This balance cannot be read online</h2>
                            <div class="alert-mb alert-mb--info mt-3">
                                @(Model.Amount.PolicyNote ?? Model.Amount.Message)
                            </div>
                            <div class="mt-4">
                                <a class="btn btn-mb-primary" asp-controller="Home" asp-action="Guide">See how to read it at a station</a>
                            </div>
                        </div>
                    }
                }
                else if (Model.HasGuidance && Model.Enquiry is not null)
                {
                    @await Html.PartialAsync("_CardGuidance", Model.Enquiry)
                }
                else if (Model.HasResults && Model.Statement is not null)
                {
                    var statement = Model.Statement;

                    <div class="balance-card mb-4">
                        <div class="position-relative" style="z-index:2;">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                <div>
                                    <div class="hero-visual__label">Available balance &mdash; DEMO DATA</div>
                                    <div class="balance-amount">@statement.Balance.BalanceFormatted</div>
                                    <div class="opacity-75">@statement.Balance.CardNumber</div>
                                </div>
                                <div class="text-md-end">
                                    <span class="badge-demo">Demo Data</span>
                                    <div class="mt-2 small opacity-75">
                                        @(statement.Balance.LastUpdatedOnFormatted is null ? "Last update not available" : "Last updated " + statement.Balance.LastUpdatedOnFormatted)
                                    </div>
                                </div>
                            </div>
                            <div class="row g-3 mt-4">
                                <div class="col-6 col-md-3">
                                    <div class="hero-visual__label">Holder</div>
                                    <div class="fw-semibold">@statement.Balance.CardHolderName</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="hero-visual__label">Card type</div>
                                    <div class="fw-semibold">@statement.Balance.CardType</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="hero-visual__label">Status</div>
                                    <div class="fw-semibold">@statement.Balance.Status</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="hero-visual__label">Total recharged</div>
                                    <div class="fw-semibold">@MetroBalance.Core.Contracts.MoneyFormatter.Format(statement.Recharges.Sum(r => r.Amount))</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="hero-visual__label">Issued on</div>
                                    <div class="fw-semibold">@statement.Balance.IssuedOn.ToString("dd MMM yyyy")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-lg-5">
                            <div class="panel panel--raised h-100">
                                <div class="p-4 border-bottom">
                                    <h3 class="h6 fw-bold mb-1">Recharge history</h3>
                                    <p class="small text-muted mb-0">@statement.Recharges.Count recharges on record</p>
                                </div>
                                <div class="p-3">
                                    @if (statement.Recharges.Count == 0)
                                    {
                                        <div class="empty-state">
                                            <div class="empty-state__icon">&#128176;</div>
                                            <div class="fw-semibold">No recharges yet</div>
                                            <div class="small">This card has no top-up transactions on record.</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <ul class="timeline">
                                            @foreach (var recharge in statement.Recharges)
                                            {
                                                <li class="timeline__item">
                                                    <span class="timeline__dot timeline__dot--green"></span>
                                                    <div class="timeline__title">@recharge.AmountFormatted <span class="small text-muted">via @recharge.Channel</span></div>
                                                    <div class="timeline__meta">@recharge.TimestampFormatted &middot; @recharge.Mode &middot; Balance @recharge.BalanceAfterFormatted</div>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="panel panel--raised h-100">
                                <div class="p-4 border-bottom d-flex justify-content-between align-items-center gap-2">
                                    <div>
                                        <h3 class="h6 fw-bold mb-1">Journey transactions</h3>
                                        <p class="small text-muted mb-0">Fare deductions at the gates</p>
                                    </div>
                                    <span class="meta-pill">@statement.Transactions.Count journeys</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-mb align-middle">
                                        <thead>
                                            <tr>
                                                <th class="ps-3">Date &amp; time</th>
                                                <th>Journey</th>
                                                <th>Line</th>
                                                <th class="text-end pe-3">Fare</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (statement.Transactions.Count == 0)
                                            {
                                                <tr><td colspan="4" class="text-center text-muted py-4">No journey transactions on record.</td></tr>
                                            }
                                            else
                                            {
                                                @foreach (var transaction in statement.Transactions)
                                                {
                                                    <tr>
                                                        <td class="ps-3 text-nowrap">@transaction.TimestampFormatted</td>
                                                        <td>@transaction.FromStation &rarr; @transaction.ToStation</td>
                                                        <td><span class="meta-pill">@transaction.Line</span></td>
                                                        <td class="text-end pe-3 amount-debit">@transaction.AmountFormatted</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="panel p-5 text-center">
                        <div class="empty-state">
                            <div class="empty-state__icon">
                                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="16" rx="3"></rect><path d="M3 9h18"></path><path d="M7 14h5"></path>
                                </svg>
                            </div>
                            <h2 class="h5 fw-bold">Enter a card number to begin</h2>
            <p class="mb-4" style="max-width:32rem;margin-inline:auto;">
                                Type your Smart Card number on the left and we will show the balance, recharge history
                                and journey transactions straight away.
                            </p>
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                @foreach (var demoCard in Model.DemoCardNumbers.Take(4))
                                {
                                    <a class="demo-chip text-decoration-none" href="@Url.Action("Index", "Card", new { cardNumber = demoCard, mode = Model.AmountOnly ? "amount" : null })">@demoCard</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
