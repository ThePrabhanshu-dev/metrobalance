@model MetroBalance.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <h1 class="display-5 fw-bold text-primary">Oops! Something went wrong.</h1>
    <p class="lead text-muted mt-3">
        We could not process your request. Please try again in a moment.
    </p>
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
