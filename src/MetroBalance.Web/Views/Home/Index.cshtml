@{
    ViewData["Title"] = "Delhi Metro Smart Card Balance Checker";
}

<section class="hero">
    <div class="container position-relative" style="z-index:2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="hero__eyebrow">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2l2.4 5.1 5.6.8-4 4 .9 5.6L12 14.9 7.1 17.5 8 11.9l-4-4 5.6-.8L12 2z"></path>
                    </svg>
                    100% free &middot; No login &middot; No database
                </span>
                <h1 class="mt-3 mb-3">
                    Check your <span class="highlight">Delhi Metro</span> Smart Card balance in seconds.
                </h1>
                <p class="hero__lead mb-0">
                    Type your Smart Card number and instantly see <strong>how much money is left on the card</strong>,
                    <strong>every top-up you made</strong> and <strong>every trip the fare was deducted from</strong>
                    &mdash; in rupees, on your phone, without a login.
                </p>

                <ul class="checklist mt-4">
                    <li>Know what you have before you travel &mdash; no queue at the Add Value Machine.</li>
                    <li>See every recharge and every fare deduction, so nothing looks like a mystery.</li>
                    <li>Free, private and instant &mdash; no app, no sign-up, no card details stored.</li>
                </ul>

                <div class="hero__stats">
                    <div>
                        <div class="hero__stat-value">&#8377;</div>
                        <div class="hero__stat-label">Money left on card</div>
                    </div>
                    <div>
                        <div class="hero__stat-value">6</div>
                        <div class="hero__stat-label">Metro lines covered</div>
                    </div>
                    <div>
                        <div class="hero__stat-value">24/7</div>
                        <div class="hero__stat-label">Works any time</div>
                    </div>
                    <div>
                        <div class="hero__stat-value">0</div>
                        <div class="hero__stat-label">Forms to fill in</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="hero-visual">
                    <div class="hero-visual__label">Sample card &mdash; DEMO</div>
                    <div class="d-flex align-items-center justify-content-between mt-1 mb-3">
                        <div>
                            <div style="font-size:.78rem;color:rgba(255,255,255,.55);">Card holder</div>
                            <div style="font-weight:600;">Aarav Sharma</div>
                        </div>
                        <div class="text-end">
                            <div style="font-size:.78rem;color:rgba(255,255,255,.55);">Card type</div>
                            <div style="font-weight:600;">Silver</div>
                        </div>
                    </div>
                    <div class="hero-visual__label mb-1">Money left on the card</div>
                    <div class="hero-visual__amount">&#8377; 425.50</div>
                    <div class="hero-visual__row mt-3">
                        <span>Last journey</span>
                        <span>Rajiv Chowk &rarr; Central Secretariat</span>
                    </div>
                    <div class="hero-visual__row">
                        <span>Last updated</span>
                        <span>26 Nov 2026, 08:12 AM</span>
                    </div>
                    <div class="line-strip">
                        <span class="line-chip line-chip--blue">Blue</span>
                        <span class="line-chip line-chip--yellow">Yellow</span>
                        <span class="line-chip line-chip--red">Red</span>
                        <span class="line-chip line-chip--violet">Violet</span>
                        <span class="line-chip line-chip--pink">Pink</span>
                        <span class="line-chip line-chip--green">Green</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section--tight">
    <div class="container">
        <div class="lookup-card mx-auto" style="max-width: 980px;">
            <h2 class="h4 fw-bold mb-1">How much money is left on your card?</h2>
            <p class="text-muted mb-4">
                Enter the number printed on your Smart Card. Nothing else is needed &mdash; no login, no registration,
                no payment.
            </p>

            <div class="mode-switch" role="group" aria-label="What would you like to see?">
                <button type="button" class="mode-switch__btn is-active" id="modeAmount" data-mode="amount" aria-pressed="true">
                    Just the balance
                </button>
                <button type="button" class="mode-switch__btn" id="modeStatement" data-mode="statement" aria-pressed="false">
                    Balance + history
                </button>
            </div>
            <p class="small text-muted mb-4">
                <strong>Just the balance</strong> shows one number: the money left on your card.
                <strong>Balance + history</strong> also shows every recharge and every journey fare.
            </p>

            <details class="howto mb-4">
                <summary>Where do I find my Smart Card number?</summary>
                <div class="howto__body">
                    <ol>
                        <li>Look at the front of your card &mdash; the number is printed on it.</li>
                        <li>Use the 12-digit number printed on the card (it may be shown in groups like <code>8177 7696 0017</code>).</li>
                        <li>Type it below. Spaces are fine, we ignore them.</li>
                    </ol>
                    <p class="mb-0">
                        Lost card or damaged number? <a asp-controller="Card" asp-action="Index" asp-route-mode="guide">See how to read a real card balance</a>.
                    </p>
                </div>
            </details>

            <form id="cardLookupForm" novalidate>
                <div class="row g-3 align-items-end">
                    <div class="col-lg-7">
                        <label class="form-label fw-semibold" for="cardNumberInput">Smart Card number</label>
                        <input type="text" class="form-control lookup-input" id="cardNumberInput" name="cardNumber"
                               placeholder="e.g. 8177 7696 0017 5160" autocomplete="off" spellcheck="false" maxlength="25" />
                        <div class="form-text">
                            Type the number and press <strong>Check balance</strong>. Demo cards are listed below &mdash;
                            pick one to try the full flow.
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <button type="submit" class="btn btn-mb-primary w-100" id="cardLookupButton">
                            <span class="spinner-border spinner-border-sm me-2 d-none" id="lookupSpinner" aria-hidden="true"></span>
                            <span id="lookupButtonText">Check balance</span>
                        </button>
                    </div>
                </div>
            </form>

            <div class="mt-4">
                <div class="small text-uppercase fw-bold text-muted mb-2" style="letter-spacing:.08em;">Try a demo card</div>
                <div class="d-flex flex-wrap gap-2" id="demoCardChips">
                    <span class="text-muted small">Loading demo cards&hellip;</span>
                </div>
            </div>

            <div class="help-note mt-4">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z"></path>
                </svg>
                <span>Your card number is only used to answer your query &mdash; it is not stored, not shared and not sold.</span>
            </div>

            <div id="lookupAlert" class="alert-mb mt-4 d-none"></div>
        </div>
    </div>
</section>

<section class="result-shell" id="amountSection">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="balance-card" id="amountCard">
                    <div class="position-relative" style="z-index:2;">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div>
                                <div class="hero-visual__label">Money left on your card &mdash; DEMO DATA</div>
                                <div class="balance-amount" id="amountValue">&mdash;</div>
                                <div class="opacity-75" id="amountMeta">Card number</div>
                                <p class="plain-meaning mb-0">This is the money still in your card for travel.</p>
                            </div>
                            <div class="text-md-end">
                                <span class="badge-demo">Demo Data</span>
                                <div class="mt-2 small opacity-75" id="amountLastUpdated">&mdash;</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert-mb alert-mb--info mt-4 d-none" id="amountUnavailable">
                    This card cannot be read online &mdash; DMRC does not offer an internet balance service yet.
                    <a class="fw-semibold" href="#guidanceSection">See how to check your balance at the station</a>.
                </div>

                <div class="text-center mt-4">
                    <button type="button" class="btn btn-mb-outline" id="amountFullStatementButton">
                        Also show recharge &amp; journey history
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="result-shell" id="resultSection">
    <div class="container">
        <div class="row g-4">
            <div class="col-12">
                <div class="balance-card">
                    <div class="position-relative" style="z-index:2;">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div>
                                <div class="hero-visual__label">Money left on your card &mdash; DEMO DATA</div>
                                <div class="balance-amount" id="balanceAmount">&#8377; 0.00</div>
                                <div class="opacity-75" id="balanceCardMeta">Card number</div>
                                <p class="plain-meaning mb-0">This is the money still in your card for travel.</p>
                            </div>
                            <div class="text-md-end">
                                <span class="badge-demo">Demo Data</span>
                                <div class="mt-2 small opacity-75" id="balanceLastUpdated">&mdash;</div>
                            </div>
                        </div>

                        <div class="row g-3 mt-4">
                            <div class="col-6 col-md-3">
                                <div class="hero-visual__label">Card holder</div>
                                <div class="fw-semibold" id="balanceHolder">&mdash;</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="hero-visual__label">Card type</div>
                                <div class="fw-semibold" id="balanceCardType">&mdash;</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="hero-visual__label">Card status</div>
                                <div class="fw-semibold" id="balanceStatus">&mdash;</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="hero-visual__label">Total money added</div>
                                <div class="fw-semibold" id="balanceTotalRecharged">&mdash;</div>
                            </div>
                        </div>
                        <p class="plain-meaning mt-3 mb-0">
                            <strong>Total money added</strong> is everything you have topped up since the card was issued.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="panel panel--raised h-100">
                    <div class="p-4 border-bottom">
                        <h3 class="h6 fw-bold mb-1">Every time you added money</h3>
                        <p class="small text-muted mb-0">All your top-ups, with amount and date</p>
                    </div>
                    <div class="p-3" id="rechargeList"></div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="panel panel--raised h-100">
                    <div class="p-4 border-bottom d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <h3 class="h6 fw-bold mb-1">Every trip and what it cost</h3>
                            <p class="small text-muted mb-0">From which station to which, and the fare taken</p>
                        </div>
                        <span class="meta-pill" id="journeyCountLabel">0 journeys</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-mb table-mb align-middle">
                            <thead>
                                <tr>
                                    <th class="ps-3">Date &amp; time</th>
                                    <th>Journey</th>
                                    <th>Line</th>
                                    <th class="text-end pe-3">Fare</th>
                                </tr>
                            </thead>
                            <tbody id="transactionTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="result-shell" id="guidanceSection">
    <div class="container">
        <div class="panel panel--raised p-4 p-lg-5">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <span class="badge-demo">Real card &mdash; no online balance</span>
                    <h2 class="h5 fw-bold mt-3 mb-2">How to read the balance of <span id="guidanceCardNumber">your card</span></h2>
                    <p class="text-muted mb-0" style="max-width:46rem;">
                        DMRC does not publish an online card balance service, so no website can show a live balance for
                        a real card. MetroBalance never invents one &mdash; here is exactly how to read it yourself.
                    </p>
                </div>
                <div class="text-md-end">
                    <span class="meta-pill" id="guidanceCardKind">Card type</span>
                </div>
            </div>

            <div class="alert-mb alert-mb--info mb-4" id="guidancePolicy">
                DMRC does not publish a service that returns a card balance over the internet.
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <h3 class="h6 fw-bold mb-3">Read it at the station</h3>
                    <ol class="guide-steps" id="guidanceSteps"></ol>
                </div>
                <div class="col-lg-6">
                    <h3 class="h6 fw-bold mb-3">Official DMRC channels</h3>
                    <div class="d-flex flex-column gap-2" id="guidanceLinks"></div>
                </div>
            </div>
        </div>
    </div>
</section>

